# Compose PostgreSQL password; Compose passes it to the API container.
POSTGRES_PASSWORD=mysecretpassword

# Host-run API connection for local development (Compose overrides these in its API container).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=mysecretpassword
DATABASE_NAME=record

# Published host ports.
NODE_ENV=development
POSTGRES_PORT=5433
API_PORT=3000
WEB_PORT=8080

# Passkey relying-party settings. For local Compose, use localhost; set the public
# HTTPS domain on the server.
PASSKEY_RP_NAME=Packing Video Manager
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:8080
PASSKEY_ENROLLMENT_SECRET=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=28800
