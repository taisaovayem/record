# Used by both the Compose PostgreSQL container and its API connection.
POSTGRES_PASSWORD=mysecretpassword

# Host-run API connection for local development (Compose overrides DATABASE_HOST to db).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_NAME=record

# Published host ports.
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=8080
